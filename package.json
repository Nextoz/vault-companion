{
  "name": "vault-companion",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "build": "pnpm -r --if-present build",
    "deploy:dry": "pnpm --filter @vault-companion/worker build"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
